<!-- Scripts -->
<% if (theme.cdn && theme.cdn.enable) { %>
<script src="<%= theme.cdn.url %>js/pjax.min.js"></script>
<% } else { %>
<script src="<%- url_for('js/pjax.min.js') %>"></script>
<% } %>

<!-- JS -->
<% if (theme.cdn && theme.cdn.enable) { %>
<script src="<%= theme.cdn.url %>js/main.js"></script>
<% } else { %>
<script src="<%- url_for('js/main.js') %>"></script>
<% } %>

<!-- Artalk (Comment System) -->
<% if (theme.artalk && theme.artalk.enable) { %>
    <% 
        var artalkCss = theme.artalk.css_url;
        var artalkJs = theme.artalk.js_url;
        
        if (!artalkCss) {
            artalkCss = (theme.cdn && theme.cdn.enable) ? theme.cdn.url + 'css/Artalk.css' : url_for('css/Artalk.css');
        }
        
        if (!artalkJs) {
            artalkJs = (theme.cdn && theme.cdn.enable) ? theme.cdn.url + 'js/Artalk.js' : url_for('js/Artalk.js');
        }
    %>
    <link href="<%- artalkCss %>" rel="stylesheet" />
    <script src="<%- artalkJs %>"></script>
<% } %>

<% if (is_post() && theme.artalk && theme.artalk.enable) { %>
    <script>
        window.artalkConfig = {
            server: '<%- theme.artalk.server %>',
            site: '<%- theme.artalk.site %>',
            pageKey: '<%= page.path %>',
            pageTitle: '<%= page.title %>',
            darkMode: false
        };
    </script>
<% } %>


<!-- Waline (Comment System) -->
<% if (theme.waline && theme.waline.enable) { %>
    <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
    <script>
        function initWaline() {
            const container = document.getElementById('waline');
            if (!container) return;

            if (window.walineInstance) {
                try { window.walineInstance.destroy(); } catch(e) {}
            }

            import('https://unpkg.com/@waline/client@v3/dist/waline.js')
                .then(module => {
                    window.walineInstance = module.init({
                        el: '#waline',
                        serverURL: 'https://waline-lake-oazkg50kn-orifinder.vercel.app',
                        lang: 'en',
                        dark: 'html.dark',
                        login: 'enable',
                        pageview: true,
                    });
                })
                .catch(err => console.warn('Waline 加载失败:', err));
        }

        // 页面加载时执行
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initWaline, 300);
        });

        // Pjax 切换后重新执行
        document.addEventListener('pjax:complete', function() {
            setTimeout(initWaline, 400);
        });
    </script>
<% } %>